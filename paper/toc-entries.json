[
 {
  "level": 1,
  "text": "תקציר"
 },
 {
  "level": 1,
  "text": "1. מבוא"
 },
 {
  "level": 2,
  "text": "1.1 שאלות המחקר"
 },
 {
  "level": 2,
  "text": "1.2 מבנה העבודה"
 },
 {
  "level": 1,
  "text": "2. רקע תאורטי"
 },
 {
  "level": 2,
  "text": "2.1 הסיפור העברי הקצר ופואטיקת קרת"
 },
 {
  "level": 2,
  "text": "2.2 בדידות, ניכור וקשר בחברה המאוחרת"
 },
 {
  "level": 2,
  "text": "2.3 האנשה, אובייקט מעבר ומכונות מדברות"
 },
 {
  "level": 2,
  "text": "2.4 אבל, זיכרון והמחשבה שאין לדכא"
 },
 {
  "level": 1,
  "text": "3. פרק ראשון: \"שוברים את החזיר\" – הנפש שהילד מעניק לחרס"
 },
 {
  "level": 2,
  "text": "3.1 עלילה ומבנה"
 },
 {
  "level": 2,
  "text": "3.2 עיצוב דמות הבודד: הילד שאין לו נמען"
 },
 {
  "level": 2,
  "text": "3.3 האובייקט: מן הכלי אל הידיד"
 },
 {
  "level": 2,
  "text": "3.4 הסיום: השחרור כמעשה של ברית"
 },
 {
  "level": 1,
  "text": "4. פרק שני: \"דוב קוטב\" – זיגמונד, ברכה והחושך"
 },
 {
  "level": 2,
  "text": "4.1 המסגרת: טכנולוגיה שמאבדת עניין"
 },
 {
  "level": 2,
  "text": "4.2 ברכה בוחניק: אבל שאין ממנו מוצא"
 },
 {
  "level": 2,
  "text": "4.3 זיגמונד כתחליף: השם, ההמלצה והמלכודת"
 },
 {
  "level": 2,
  "text": "4.4 הדיאלוג: מה שהמכונה יודעת ומה שאינה מבינה"
 },
 {
  "level": 2,
  "text": "4.5 הסיום: השתיקה והחשיכה"
 },
 {
  "level": 1,
  "text": "5. פרק שלישי: השוואה – שלושים שנה בין שני בני־לוויה"
 },
 {
  "level": 2,
  "text": "5.1 שתי דמויות בשולי המערכת"
 },
 {
  "level": 2,
  "text": "5.2 האובייקט: מן החרס האילם אל בינת־העל המדברת"
 },
 {
  "level": 2,
  "text": "5.3 שני סיומים: יציאה אל השדה מול חושך בחדר"
 },
 {
  "level": 2,
  "text": "5.4 תמורות בפואטיקה: מן הגרוטסקה הפרטית אל הדיסטופיה"
 },
 {
  "level": 1,
  "text": "6. דיון"
 },
 {
  "level": 2,
  "text": "6.1 עיצוב הבודד: הבדידות כמבנה ולא כתחושה"
 },
 {
  "level": 2,
  "text": "6.2 תפקיד האובייקט: תחליף, מתווך או מלכודת"
 },
 {
  "level": 2,
  "text": "6.3 תמורה בת שלושים שנה: מן החוסר אל העודף"
 },
 {
  "level": 2,
  "text": "6.4 הערה על הסיפור הקצר כצורה"
 },
 {
  "level": 1,
  "text": "7. סיכום ומסקנות"
 },
 {
  "level": 2,
  "text": "7.1 מגבלות המחקר והצעות להמשך"
 },
 {
  "level": 1,
  "text": "8. ביבליוגרפיה"
 },
 {
  "level": 1,
  "text": "9. רפלקציה"
 },
 {
  "level": 2,
  "text": "9.1 בחירת הנושא"
 },
 {
  "level": 2,
  "text": "9.2 בניית שאלות המחקר"
 },
 {
  "level": 2,
  "text": "9.3 איסוף המקורות"
 },
 {
  "level": 2,
  "text": "9.4 תהליך הכתיבה"
 },
 {
  "level": 2,
  "text": "9.5 תובנות"
 },
 {
  "level": 1,
  "text": "10. נספחים"
 }
]