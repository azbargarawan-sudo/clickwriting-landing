[
 {
  "level": 1,
  "text": "תקציר"
 },
 {
  "level": 1,
  "text": "1. מבוא"
 },
 {
  "level": 2,
  "text": "1.1 שאלות המחקר"
 },
 {
  "level": 2,
  "text": "1.2 מבנה העבודה"
 },
 {
  "level": 1,
  "text": "2. רקע תאורטי"
 },
 {
  "level": 2,
  "text": "2.1 הזמן בכתיבתו של קרת"
 },
 {
  "level": 2,
  "text": "2.2 העתיד כז'אנר בספרות העברית העכשווית"
 },
 {
  "level": 2,
  "text": "2.3 בדידות בזקנה ומענים טכנולוגיים"
 },
 {
  "level": 2,
  "text": "2.4 האנשה, אפקט אלייזה וגבולות ההבנה של המכונה"
 },
 {
  "level": 2,
  "text": "2.5 שכול לאחר התאבדות ודיכוי מחשבות"
 },
 {
  "level": 1,
  "text": "3. מסגרת הסיפור: טכנולוגיה שמאבדת עניין"
 },
 {
  "level": 2,
  "text": "3.1 משפט הפתיחה"
 },
 {
  "level": 2,
  "text": "3.2 שלוש התשובות המשובשות"
 },
 {
  "level": 2,
  "text": "3.3 המומחים והתקשורת"
 },
 {
  "level": 2,
  "text": "3.4 המעבר אל הפרט"
 },
 {
  "level": 1,
  "text": "4. ברכה בוחניק: כיצד נבנית בדידות"
 },
 {
  "level": 2,
  "text": "4.1 שם המקום והמוסד"
 },
 {
  "level": 2,
  "text": "4.2 דוב הקוטב וכותרת הסיפור"
 },
 {
  "level": 2,
  "text": "4.3 סרחיו והרשימה בקווים נטויים"
 },
 {
  "level": 2,
  "text": "4.4 הרכוש שנשאר"
 },
 {
  "level": 2,
  "text": "4.5 המלצתה של פנינה"
 },
 {
  "level": 1,
  "text": "5. הדיאלוג עם זיגמונד"
 },
 {
  "level": 2,
  "text": "5.1 צורת התמליל"
 },
 {
  "level": 2,
  "text": "5.2 מזג האוויר: \"האם אתה חושב\" מול \"אני יודע בוודאות\""
 },
 {
  "level": 2,
  "text": "5.3 טקס ההדדיות"
 },
 {
  "level": 2,
  "text": "5.4 הרשומה על סרחיו"
 },
 {
  "level": 2,
  "text": "5.5 מתיחה מול שקר"
 },
 {
  "level": 2,
  "text": "5.6 הספרים והבוידעם"
 },
 {
  "level": 1,
  "text": "6. הסיום: השתיקה והחשיכה"
 },
 {
  "level": 2,
  "text": "6.1 השאלה שבאמת נשאלה"
 },
 {
  "level": 2,
  "text": "6.2 \"זיגמונד לא ענה\""
 },
 {
  "level": 2,
  "text": "6.3 החושך שהולך ומתעצם"
 },
 {
  "level": 1,
  "text": "7. דיון"
 },
 {
  "level": 2,
  "text": "7.1 בדידות שנבנית ולא מוצהרת"
 },
 {
  "level": 2,
  "text": "7.2 תפקידה של המכונה: מענה בלי הבנה"
 },
 {
  "level": 2,
  "text": "7.3 השתיקה כפסק דין"
 },
 {
  "level": 2,
  "text": "7.4 הצורה כטענה"
 },
 {
  "level": 1,
  "text": "8. סיכום ומסקנות"
 },
 {
  "level": 2,
  "text": "8.1 המלצות יישומיות"
 },
 {
  "level": 2,
  "text": "8.2 מגבלות והצעות למחקר המשך"
 },
 {
  "level": 1,
  "text": "9. ביבליוגרפיה"
 },
 {
  "level": 1,
  "text": "10. רפלקציה"
 },
 {
